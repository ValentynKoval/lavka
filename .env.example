# Supabase project settings (Project Settings -> API)
# Leave empty to run the app on the built-in demo data (mock repositories).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, used by the seed script. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force the built-in demo data even when Supabase keys are present.
# LAVKA_DATA_SOURCE=demo

# Optional: used only by `npm run db:migrate` to apply supabase/migrations via psql.
SUPABASE_DB_PASSWORD=
